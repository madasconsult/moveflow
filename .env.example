# =============================================================================
# MOVE FLOW — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite .env.local no git.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — obrigatórias
# Encontre em: Supabase Dashboard > Project Settings > API
# -----------------------------------------------------------------------------

# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

# Chave anon/public (segura para expor no frontend — protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# -----------------------------------------------------------------------------
# Supabase — apenas para scripts de administração (nunca no frontend)
# Encontre em: Supabase Dashboard > Project Settings > API > service_role key
# CUIDADO: esta chave bypassa o RLS. Nunca use NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Usado no script gen:types do package.json
SUPABASE_PROJECT_ID=seu_project_id_aqui

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MOVE FLOW

# -----------------------------------------------------------------------------
# AI Insights (Fase 1 — infraestrutura reversível)
# Protegido por feature flag. Restrito a admin_faus nesta fase.
# Dados pessoais nunca são enviados à IA.
# Documentação: src/app/api/ai/report-insights/route.ts
# -----------------------------------------------------------------------------

# Habilita o endpoint POST /api/ai/report-insights.
# Mantenha false em produção até validação completa.
ENABLE_AI_INSIGHTS=false

# Chave da API OpenAI. Obrigatória quando ENABLE_AI_INSIGHTS=true.
# Encontre em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo OpenAI a usar. Padrão seguro: gpt-4o-mini.
# Modelos suportados: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-4, gpt-3.5-turbo, o1, o1-mini, o3, o3-mini
OPENAI_MODEL=gpt-4o-mini
